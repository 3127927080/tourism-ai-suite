AI_DATABASE_URL=postgresql+psycopg://customer_service:customer_service@127.0.0.1:5432/ai_customer_service
API_HOST=0.0.0.0
API_PORT=8002
INTERNAL_SERVICE_TOKEN=customer-internal-token

# 旅游数据服务（tourism-service，8001）
TOURISM_DATA_BASE_URL=http://127.0.0.1:8001/api/v1
TOURISM_DATA_TIMEOUT_SECONDS=8
# 兼容旧变量（未配置 TOURISM_DATA_BASE_URL 时回退）
ECOMMERCE_BASE_URL=
ECOMMERCE_TIMEOUT_SECONDS=

KNOWLEDGE_BASE_URL=http://127.0.0.1:8005/api/v1
KNOWLEDGE_TIMEOUT_SECONDS=45
KNOWLEDGE_TOP_K=5
KNOWLEDGE_SERVICE_TOKEN=knowledge-internal-token
JWT_SECRET=ecommerce-secret
JWT_ALGORITHM=HS256

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_PROVIDER=openai_compatible
LLM_THINKING_MODE=enabled
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
PROMPT_VERSION=tourism-support-v1

# Agent 运行约束
AGENT_TOOL_CALL_LIMIT=8
AGENT_RUN_TIMEOUT_SECONDS=90
# 流式输出每次下发的文本块字符数
STREAM_CHUNK_SIZE=3

# ---- 离线评估（eval/），不参与服务运行 ----
EVAL_USER_ID=eval-customer
# 订单/出行/退款类样本需要真实用户 JWT
EVAL_USER_TOKEN=
EVAL_JUDGE_MODEL=
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_API_KEY=
# 三项都配置前才会启用 answer_relevancy / answer_correctness
EVAL_EMBEDDING_MODEL=
EVAL_EMBEDDING_BASE_URL=
EVAL_EMBEDDING_API_KEY=
EVAL_TIMEOUT_SECONDS=180
