# ---- 离线评估（eval/），不参与服务运行 ----
EVAL_USER_ID=eval-customer
# 订单/物流/售后类样本需要真实用户 JWT
EVAL_USER_TOKEN=
EVAL_JUDGE_MODEL=
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_API_KEY=
