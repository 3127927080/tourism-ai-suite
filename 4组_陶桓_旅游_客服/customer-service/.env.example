DATABASE_URL=postgresql+psycopg://customer_service:customer_service@192.168.200.188:5432/customer_service
REDIS_URL=redis://192.168.200.188:6379/0
INTERNAL_SERVICE_JWT_SECRET=customer-internal-token
INTERNAL_SERVICE_JWT_ALGORITHM=HS256
INTERNAL_SERVICE_TOKEN=customer-internal-token
JWT_SECRET=ecommerce-secret
JWT_ALGORITHM=HS256

# AI Service 地址与调用超时时间（秒）；知识检索 45s + LLM 生成，建议 ≥120
AI_SERVICE_URL=http://127.0.0.1:8002
AI_TIMEOUT_SECONDS=120

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# 会话空闲超时阈值
CONVERSATION_IDLE_TIMEOUT_MINUTES=30

#防抖窗口的时间800毫秒
MESSAGE_MERGE_DELAY_MS=800
#防抖窗口的最大延迟时间2000毫秒
MESSAGE_MERGE_MAX_WAIT_MS=2000

#ai_worker的几个配置项:轮询的时间间隔,任务租约时间，单位秒,最大尝试次数,重试间隔时间
AI_WORKER_POLL_INTERVAL_MS=100
AI_WORKER_LEASE_SECONDS=120
AI_WORKER_MAX_ATTEMPTS=3
AI_WORKER_RETRY_DELAY_SECONDS=2

OUTBOX_WORKER_POLL_INTERVAL_SECONDS=1