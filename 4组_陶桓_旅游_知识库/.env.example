# ====================
# MinerU API
# ====================
MINERU_TOKEN=xxxxxxxxxxxx

# ====================
# 阿里云 DashScope 凭据（Rerank、视觉理解仍在用）
# ====================
# API 密钥（兼容 OpenAI 格式）
ALIYUN_API_KEY=xxxxxxxxxxxx
# API 基础地址（阿里云 DashScope）
ALIYUN_API_BASE=xxxxxxxxxxxxxxxx

# ====================
# 语言模型凭据（答案生成 / 槽位识别 / 元数据解析 / 三元组抽取 / Ragas 判分）
# 留空则自动回退到 ALIYUN_API_KEY / ALIYUN_API_BASE
# ====================
LLM_API_KEY=
# 例：DeepSeek 填 https://api.deepseek.com
LLM_API_BASE=

# 视觉模型凭据（留空则回退阿里云）
VL_API_KEY=
VL_API_BASE=

# 默认 LLM 模型（语言模型，走 LLM_API_BASE）
LLM_DEFAULT_MODEL=deepseek-v4.1-flash
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型（走 VL_API_BASE / 阿里云）
VL_MODEL=qwen3-vl-flash
# 槽位识别与 Ragas 判分模型（走 LLM_API_BASE）
ITEM_MODEL=deepseek-v4.1-flash

# ====================
# Object Storage (MinIO)
# ====================
# MinIO 服务端点
MINIO_ENDPOINT=xxxxxxxxxx
# 访问密钥
MINIO_ACCESS_KEY=xxxxxxxxxxxxx
# 私有密钥
MINIO_SECRET_KEY=xxxxxxxxxxx
# 存储桶名称
MINIO_BUCKET_NAME=xxxxxxx
# 图片上传目录
MINIO_IMG_DIR=xxxxxxxxxx

# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径（根据下载模型的成功提示来设置）
BGE_M3_PATH=xxxxxxxxxxxxx
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备，cuda:0表示使用第1块GPU，cpu表示使用CPU，cuda:N表示第N+1块GPU
BGE_DEVICE=cuda:0
# 是否使用半精度（True/False）1=开启（GPU加速更高效），0=关闭（兼容低版本GPU/CPU）
BGE_FP16=True


# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址
MILVUS_URL=http://xxx.xxx.xxx.xx:19530
# 知识库切片集合名
CHUNKS_COLLECTION=chunks_tourism_v1
# 商品名称集合名
ITEM_NAME_COLLECTION=item_name_tourism_v1

# MongoDB 连接 URL
MONGO_URL=mongodb://xxx.xxx.xxx.xxx:27017
# 数据库名
MONGO_DB_NAME=kb_message

# MCP Web 搜索服务地址
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
# MCP 独立 key（百炼网络搜索使用，不与 LLM 供应商绑定）
MCP_API_KEY=xxxxxxxxxx

# rerank 重排序模型
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=xxxxxxxxxxxxxxxx
RERANK_API_KEY=xxxxxxxxxxxx

# 客服系统调用知识检索接口的内部令牌，须与 ai-service 的 KNOWLEDGE_SERVICE_TOKEN 一致
KNOWLEDGE_SERVICE_TOKEN=xxxxxxxxxx

# ====================
# 旅游知识库改造
# ====================
UPLOAD_ROOT=C:\Users\th\Desktop\4组_陶桓_实战\4组_陶桓_旅游_知识库\output
ENABLE_HYDE=false
ENABLE_GRAPH=false
ENABLE_WEB_SEARCH=false
ENABLE_GRAPH_EXTRACT=false
